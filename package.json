{
    "name": "advanced_auth_nest",
    "version": "0.0.1",
    "description": "",
    "author": "",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "prepare": "husky",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e:docker:up": "docker compose -f docker-compose.test.yml up -d --build",
        "test:e2e:docker:down": "docker compose -f docker-compose.test.yml down -v",
        "test:e2e:wait:postgres": "wait-on tcp:5434",
        "test:e2e:wait:redis": "wait-on tcp:6380",
        "test:e2e:setup:db": "dotenv -e .env.ci -- prisma db push --force-reset",
        "test:e2e:reset": "dotenv -e .env.ci -- prisma migrate reset --force",
        "test:e2e:run": "cross-env NODE_OPTIONS='--experimental-vm-modules' dotenv -e .env.ci -- jest --config ./test/jest-e2e.json --runInBand",
        "test:e2e:ci": "npm run test:e2e:docker:up && npm run test:e2e:wait:postgres && npm run test:e2e:wait:redis && npm run test:e2e:setup:db && npm run test:e2e:run",
        "test:e2e:local": "npm run test:e2e:docker:down && npm run test:e2e:ci && npm run test:e2e:docker:down",
        "docker:up": "docker compose --env-file .env.docker up -d --build",
        "docker:down": "docker compose down -v",
        "db:deploy": "npx prisma migrate deploy && npx prisma generate"
    },
    "lint-staged": {
        "{ts,js}": [
            "eslint --fix",
            "prettier --write"
        ]
    },
    "dependencies": {
        "@nestjs-modules/mailer": "^2.3.4",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.4",
        "@nestjs/core": "^11.0.1",
        "@nestjs/mapped-types": "*",
        "@nestjs/platform-express": "^11.0.1",
        "@nestlab/google-recaptcha": "^3.11.1",
        "@prisma/adapter-pg": "^7.7.0",
        "@prisma/client": "^7.7.0",
        "@react-email/components": "^1.0.12",
        "@react-email/html": "^0.0.12",
        "argon2": "^0.44.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.15.1",
        "connect-redis": "^9.0.0",
        "cookie-parser": "^1.4.7",
        "express-session": "^1.19.0",
        "redis": "^5.12.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.0",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@types/cookie-parser": "^1.4.10",
        "@types/express": "^5.0.0",
        "@types/express-session": "^1.19.0",
        "@types/jest": "^30.0.0",
        "@types/node": "^24.0.0",
        "@types/react": "^19.2.14",
        "@types/supertest": "^7.0.0",
        "@types/uuid": "^10.0.0",
        "cross-env": "^10.1.0",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "eslint-plugin-simple-import-sort": "^13.0.0",
        "globals": "^17.0.0",
        "husky": "^9.1.7",
        "jest": "^30.0.0",
        "jest-mock-extended": "^4.0.1",
        "lint-staged": "^16.4.0",
        "prettier": "^3.4.2",
        "prisma": "^7.7.0",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0",
        "wait-on": "^9.0.10"
    }
}
